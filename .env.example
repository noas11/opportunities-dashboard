# Required — SAP Sales Cloud V2 Basic Auth credentials
SAP_USERNAME=your_sap_username
SAP_PASSWORD=your_sap_password

# Optional — override if your tenant/API path differs from the default
# SAP_BASE_URL=https://my1002519.de1.crm.cloud.sap/sap/c4c/api/v1/opportunity-service/opportunities

# Optional — server port (default 3000)
# PORT=3000

# Optional — set to "true" to run the dashboard against generated sample data
# instead of calling the real SAP API (useful for local UI development/demo)
# USE_MOCK_DATA=true
